# 环境变量配置
# 复制此文件为 .env 并填入实际值

# 数据库连接 (Neon PostgreSQL)
# 在 https://neon.tech 注册免费账号并创建数据库后获取
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/grbk?sslmode=require"

# Session 加密密钥（至少 32 字符，随机生成）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="请替换为随机生成的至少32字符的密钥"

# 站点 URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 运行环境
NODE_ENV="development"
